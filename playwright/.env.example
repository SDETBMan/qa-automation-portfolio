# playwright — Environment variable overrides
# These override values in appsettings.json using .NET double-underscore convention.
# Example: APP__USERNAME overrides { "app": { "username": "..." } }

# Integrations (all optional — skipped if absent)
DD_API_KEY=                      # DataDog CI Visibility metrics
DD_SITE=datadoghq.com           # DataDog regional site
