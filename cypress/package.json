{
  "name": "cypress-ts",
  "version": "1.0.0",
  "description": "Cypress TypeScript E2E + Component Testing — SauceDemo",
  "scripts": {
    "test":               "cypress run --browser chrome",
    "test:smoke":         "cypress run --browser chrome --spec 'cypress/e2e/login.cy.ts,cypress/e2e/inventory.cy.ts'",
    "test:regression":    "cypress run --browser chrome --spec 'cypress/e2e/**/*.cy.ts'",
    "test:accessibility": "cypress run --browser chrome --spec 'cypress/e2e/accessibility.cy.ts'",
    "test:performance":   "cypress run --browser chrome --spec 'cypress/e2e/performance.cy.ts'",
    "test:firefox":       "cypress run --browser firefox",
    "test:edge":          "cypress run --browser edge",
    "test:component":     "cypress run --component",
    "test:browserstack":  "browserstack-cypress run --sync",
    "test:headed":        "cypress open",
    "report":             "open cypress/reports/index.html"
  },
  "devDependencies": {
    "cypress":                        "^15.18.1",
    "typescript":                     "^7.0.2",
    "react":                          "^19.2.7",
    "react-dom":                      "^19.2.7",
    "@types/react":                   "^19.2.17",
    "@types/react-dom":               "^19.2.3",
    "vite":                           "^8.1.5",
    "@vitejs/plugin-react":           "^6.0.3",
    "mocha-junit-reporter":           "^2.2.0",
    "node-fetch":                     "^3.3.0",
    "@shelex/cypress-allure-plugin":  "^2.40.2",
    "cypress-axe":                    "^1.5.0",
    "axe-core":                       "^4.12.1",
    "browserstack-cypress-cli":        "^1.36.13",
    "@cypress-audit/lighthouse":      "^1.4.0"
  }
}
