# cucumber_python — Behave BDD with Selenium
# Execution
TARGET=local                     # Execution target: local | grid | browserstack
BROWSER=chrome                   # Browser: chrome | firefox | edge
HEADLESS=false                   # Run browser in headless mode
URL=https://www.saucedemo.com    # Base application URL

# Application credentials
APP_USERNAME=standard_user       # SauceDemo test user
APP_PASSWORD=secret_sauce        # SauceDemo test password

# Selenium Grid (when TARGET=grid)
GRID_URL=http://localhost:4444   # Selenium Grid hub URL

# Healenium self-healing (optional)
HEALENIUM_PROXY=                 # Healenium proxy URL
HEALENIUM_ENABLED=               # Enable Healenium self-healing locators

# API testing
API_BASE_URL=https://jsonplaceholder.typicode.com  # API base URL

# BrowserStack (when TARGET=browserstack)
BS_USER=                         # BrowserStack username
BS_KEY=                          # BrowserStack access key

# Integrations (all optional — skipped if absent)
DD_API_KEY=                      # DataDog metrics
DD_SITE=datadoghq.com           # DataDog regional site
SLACK_WEBHOOK_URL=               # Slack failure notifications
