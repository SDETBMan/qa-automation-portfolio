# selenium-java — Environment variable overrides
# These override values in src/main/resources/config.properties.
# See config.properties for the full list of configurable settings.

# AI-driven test generation (optional)
OPENAI_API_KEY=sk-...            # OpenAI API key for AI test features

# BrowserStack / Sauce Labs (when execution_mode=cloud)
BROWSERSTACK_USERNAME=           # BrowserStack username
BROWSERSTACK_ACCESS_KEY=         # BrowserStack access key

# Integrations (all optional — skipped if absent)
DD_API_KEY=                      # DataDog CI Visibility metrics
DD_SITE=datadoghq.com           # DataDog regional site
SLACK_WEBHOOK_URL=               # Slack failure notifications
