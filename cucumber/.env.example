# cucumber — Environment variable overrides
# These override values in src/test/resources/config.properties.
# See config.properties for the full list of configurable settings.

# BrowserStack (when target=browserstack)
BS_USER=                         # BrowserStack username
BS_KEY=                          # BrowserStack access key

# Integrations (all optional — skipped if absent)
DD_API_KEY=                      # DataDog CI Visibility metrics
DD_SITE=datadoghq.com           # DataDog regional site
SLACK_WEBHOOK_URL=               # Slack failure notifications
