# Anthropic API key — obtain from https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Absolute path to the monorepo root (e.g. /home/user/qa-automation-portfolio)
# Defaults to the parent of the coding-agent/ directory if not set.
REPO_ROOT=/path/to/qa-automation-portfolio

# AgentOps API key — obtain from https://app.agentops.ai (optional; skipped if not set)
AGENTOPS_API_KEY=your_agentops_api_key_here
