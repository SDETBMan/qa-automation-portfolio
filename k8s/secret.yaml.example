# secret.yaml.example — production replacement for configmap.yaml credentials.
#
# Usage:
#   1. Copy this file to k8s/secret.yaml
#   2. Replace the placeholder values with your real credentials
#   3. Apply:  kubectl apply -f k8s/secret.yaml
#   4. NEVER commit secret.yaml to version control — it is in .gitignore
#
# After applying, update each deployment's env block to use secretKeyRef
# instead of configMapKeyRef (see snippet below).
#
# ── secretKeyRef snippet ──────────────────────────────────────────────────────
#
#   env:
#     - name: POSTGRES_USER
#       valueFrom:
#         secretKeyRef:
#           name: healenium-secret
#           key: POSTGRES_USER
#     - name: POSTGRES_PASSWORD
#       valueFrom:
#         secretKeyRef:
#           name: healenium-secret
#           key: POSTGRES_PASSWORD
#     - name: POSTGRES_DB
#       valueFrom:
#         secretKeyRef:
#           name: healenium-secret
#           key: POSTGRES_DB
#
# ─────────────────────────────────────────────────────────────────────────────

apiVersion: v1
kind: Secret
metadata:
  name: healenium-secret
  namespace: selenium-grid
type: Opaque
stringData:
  POSTGRES_HOST: postgres-db
  POSTGRES_DB: healenium_db
  POSTGRES_USER: change-me
  POSTGRES_PASSWORD: change-me
