# Copy to .env and fill in values before running locally.
# All variables are optional — tests run without them.

# DataDog API key for metrics reporting (CI Visibility)
# Leave blank to skip DataDog reporting (CI will still pass)
DD_API_KEY=
# Set DD_SITE to match your account's regional site (check your browser URL when logged in).
# Options: datadoghq.com (default) | us3.datadoghq.com | us5.datadoghq.com | eu1.datadoghq.com | ap1.datadoghq.com
DD_SITE=datadoghq.com
