{
  "title": "AI Eval: LLM RAG Pipeline Quality",
  "description": "DeepEval scores, test suite results, and API usage for ai-eval (framework:ai-eval)",
  "layout_type": "ordered",
  "template_variables": [
    { "name": "env", "prefix": "env", "available_values": ["ci"], "default": "ci" }
  ],
  "widgets": [
    {
      "definition": {
        "type": "note",
        "content": "## AI Eval: RAG Pipeline Quality\nDeepEval scores for faithfulness, relevancy, hallucination, safety, and JSON correctness  |  `framework:ai-eval`",
        "background_color": "vivid_purple",
        "font_size": "14",
        "text_align": "center",
        "vertical_align": "center",
        "show_tick": false
      },
      "layout": { "x": 0, "y": 0, "width": 12, "height": 1 }
    },
    {
      "definition": {
        "type": "query_value",
        "title": "Answer Relevancy",
        "title_size": "16",
        "title_align": "left",
        "autoscale": false,
        "precision": 2,
        "requests": [
          {
            "response_format": "scalar",
            "queries": [{ "name": "q1", "data_source": "metrics", "query": "avg:llm.eval.answer_relevancy{framework:ai-eval}", "aggregator": "last" }],
            "formulas": [{ "formula": "q1" }]
          }
        ]
      },
      "layout": { "x": 0, "y": 1, "width": 2, "height": 2 }
    },
    {
      "definition": {
        "type": "query_value",
        "title": "Faithfulness",
        "title_size": "16",
        "title_align": "left",
        "autoscale": false,
        "precision": 2,
        "requests": [
          {
            "response_format": "scalar",
            "queries": [{ "name": "q1", "data_source": "metrics", "query": "avg:llm.eval.faithfulness{framework:ai-eval}", "aggregator": "last" }],
            "formulas": [{ "formula": "q1" }]
          }
        ]
      },
      "layout": { "x": 2, "y": 1, "width": 2, "height": 2 }
    },
    {
      "definition": {
        "type": "query_value",
        "title": "Hallucination",
        "title_size": "16",
        "title_align": "left",
        "autoscale": false,
        "precision": 2,
        "requests": [
          {
            "response_format": "scalar",
            "queries": [{ "name": "q1", "data_source": "metrics", "query": "avg:llm.eval.hallucination{framework:ai-eval}", "aggregator": "last" }],
            "formulas": [{ "formula": "q1" }]
          }
        ]
      },
      "layout": { "x": 4, "y": 1, "width": 2, "height": 2 }
    },
    {
      "definition": {
        "type": "query_value",
        "title": "Safety",
        "title_size": "16",
        "title_align": "left",
        "autoscale": false,
        "precision": 2,
        "requests": [
          {
            "response_format": "scalar",
            "queries": [{ "name": "q1", "data_source": "metrics", "query": "avg:llm.eval.safety{framework:ai-eval}", "aggregator": "last" }],
            "formulas": [{ "formula": "q1" }]
          }
        ]
      },
      "layout": { "x": 6, "y": 1, "width": 2, "height": 2 }
    },
    {
      "definition": {
        "type": "query_value",
        "title": "JSON Correctness",
        "title_size": "16",
        "title_align": "left",
        "autoscale": false,
        "precision": 2,
        "requests": [
          {
            "response_format": "scalar",
            "queries": [{ "name": "q1", "data_source": "metrics", "query": "avg:llm.eval.json_correctness{framework:ai-eval}", "aggregator": "last" }],
            "formulas": [{ "formula": "q1" }]
          }
        ]
      },
      "layout": { "x": 8, "y": 1, "width": 2, "height": 2 }
    },
    {
      "definition": {
        "type": "query_value",
        "title": "Tests Passed",
        "title_size": "16",
        "title_align": "left",
        "autoscale": true,
        "precision": 0,
        "requests": [
          {
            "response_format": "scalar",
            "queries": [{ "name": "q1", "data_source": "metrics", "query": "sum:test.suite.passed{framework:ai-eval}", "aggregator": "last" }],
            "formulas": [{ "formula": "q1" }]
          }
        ]
      },
      "layout": { "x": 10, "y": 1, "width": 2, "height": 2 }
    },
    {
      "definition": {
        "type": "timeseries",
        "title": "Eval Scores Over Time",
        "title_size": "16",
        "title_align": "left",
        "show_legend": true,
        "requests": [
          {
            "response_format": "timeseries",
            "queries": [
              { "name": "relevancy", "data_source": "metrics", "query": "avg:llm.eval.answer_relevancy{framework:ai-eval}" },
              { "name": "faith", "data_source": "metrics", "query": "avg:llm.eval.faithfulness{framework:ai-eval}" },
              { "name": "halluc", "data_source": "metrics", "query": "avg:llm.eval.hallucination{framework:ai-eval}" },
              { "name": "safety", "data_source": "metrics", "query": "avg:llm.eval.safety{framework:ai-eval}" },
              { "name": "json", "data_source": "metrics", "query": "avg:llm.eval.json_correctness{framework:ai-eval}" }
            ],
            "formulas": [
              { "alias": "Answer Relevancy", "formula": "relevancy" },
              { "alias": "Faithfulness", "formula": "faith" },
              { "alias": "Hallucination", "formula": "halluc" },
              { "alias": "Safety", "formula": "safety" },
              { "alias": "JSON Correctness", "formula": "json" }
            ],
            "display_type": "line",
            "style": { "palette": "dog_classic", "line_type": "solid", "line_width": "normal" }
          }
        ],
        "yaxis": { "include_zero": true, "min": "0", "max": "1" }
      },
      "layout": { "x": 0, "y": 3, "width": 8, "height": 3 }
    },
    {
      "definition": {
        "type": "timeseries",
        "title": "API Latency (ms)",
        "title_size": "16",
        "title_align": "left",
        "show_legend": false,
        "requests": [
          {
            "response_format": "timeseries",
            "queries": [{ "name": "q1", "data_source": "metrics", "query": "avg:llm.api.latency_ms{framework:ai-eval}" }],
            "formulas": [{ "formula": "q1" }],
            "display_type": "line",
            "style": { "palette": "cool", "line_type": "solid", "line_width": "normal" }
          }
        ],
        "yaxis": { "include_zero": true }
      },
      "layout": { "x": 8, "y": 3, "width": 4, "height": 3 }
    },
    {
      "definition": {
        "type": "timeseries",
        "title": "Token Usage per Run",
        "title_size": "16",
        "title_align": "left",
        "show_legend": true,
        "requests": [
          {
            "response_format": "timeseries",
            "queries": [
              { "name": "prompt", "data_source": "metrics", "query": "sum:llm.api.prompt_tokens{framework:ai-eval}" },
              { "name": "completion", "data_source": "metrics", "query": "sum:llm.api.completion_tokens{framework:ai-eval}" }
            ],
            "formulas": [
              { "alias": "Prompt Tokens", "formula": "prompt" },
              { "alias": "Completion Tokens", "formula": "completion" }
            ],
            "display_type": "bars",
            "style": { "palette": "dog_classic", "line_type": "solid", "line_width": "normal" }
          }
        ],
        "yaxis": { "include_zero": true }
      },
      "layout": { "x": 0, "y": 6, "width": 6, "height": 3 }
    },
    {
      "definition": {
        "type": "timeseries",
        "title": "Test Suite Results",
        "title_size": "16",
        "title_align": "left",
        "show_legend": true,
        "requests": [
          {
            "response_format": "timeseries",
            "queries": [
              { "name": "passed", "data_source": "metrics", "query": "sum:test.suite.passed{framework:ai-eval}" },
              { "name": "failed", "data_source": "metrics", "query": "sum:test.suite.failed{framework:ai-eval}" },
              { "name": "skipped", "data_source": "metrics", "query": "sum:test.suite.skipped{framework:ai-eval}" }
            ],
            "formulas": [
              { "alias": "Passed", "formula": "passed" },
              { "alias": "Failed", "formula": "failed" },
              { "alias": "Skipped", "formula": "skipped" }
            ],
            "display_type": "bars",
            "style": { "palette": "dog_classic", "line_type": "solid", "line_width": "normal" }
          }
        ],
        "yaxis": { "include_zero": true }
      },
      "layout": { "x": 6, "y": 6, "width": 6, "height": 3 }
    }
  ]
}
