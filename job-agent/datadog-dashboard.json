{
  "title": "Job Agent: Claude-Powered Job Search",
  "description": "Metrics for the job-agent agentic job search pipeline (framework:job-agent)",
  "layout_type": "ordered",
  "template_variables": [
    {
      "name": "env",
      "prefix": "env",
      "available_values": ["ci"],
      "default": "ci"
    }
  ],
  "widgets": [
    {
      "definition": {
        "type": "note",
        "content": "## Job Agent: Claude-Powered Job Search\nAnthropid Claude (claude-sonnet-4-6) + Tavily  |  `service:qa-automation-portfolio`  |  `framework:job-agent`",
        "background_color": "vivid_blue",
        "font_size": "14",
        "text_align": "center",
        "vertical_align": "center",
        "show_tick": false
      },
      "layout": { "x": 0, "y": 0, "width": 12, "height": 1 }
    },
    {
      "definition": {
        "type": "query_value",
        "title": "Jobs Found",
        "title_size": "16",
        "title_align": "left",
        "autoscale": true,
        "precision": 0,
        "requests": [
          {
            "response_format": "scalar",
            "queries": [
              {
                "name": "query1",
                "data_source": "metrics",
                "query": "sum:llm.job_agent.jobs_found{framework:job-agent}",
                "aggregator": "last"
              }
            ],
            "formulas": [{ "formula": "query1" }]
          }
        ]
      },
      "layout": { "x": 0, "y": 1, "width": 4, "height": 2 }
    },
    {
      "definition": {
        "type": "query_value",
        "title": "Jobs Scored (>=6)",
        "title_size": "16",
        "title_align": "left",
        "autoscale": true,
        "precision": 0,
        "requests": [
          {
            "response_format": "scalar",
            "queries": [
              {
                "name": "query1",
                "data_source": "metrics",
                "query": "sum:llm.job_agent.jobs_scored{framework:job-agent}",
                "aggregator": "last"
              }
            ],
            "formulas": [{ "formula": "query1" }]
          }
        ]
      },
      "layout": { "x": 4, "y": 1, "width": 4, "height": 2 }
    },
    {
      "definition": {
        "type": "query_value",
        "title": "Cover Letters Drafted",
        "title_size": "16",
        "title_align": "left",
        "autoscale": true,
        "precision": 0,
        "requests": [
          {
            "response_format": "scalar",
            "queries": [
              {
                "name": "query1",
                "data_source": "metrics",
                "query": "sum:llm.job_agent.cover_letters_drafted{framework:job-agent}",
                "aggregator": "last"
              }
            ],
            "formulas": [{ "formula": "query1" }]
          }
        ]
      },
      "layout": { "x": 8, "y": 1, "width": 4, "height": 2 }
    },
    {
      "definition": {
        "type": "timeseries",
        "title": "Run Duration (ms)",
        "title_size": "16",
        "title_align": "left",
        "show_legend": false,
        "requests": [
          {
            "response_format": "timeseries",
            "queries": [
              {
                "name": "query1",
                "data_source": "metrics",
                "query": "avg:llm.job_agent.duration_ms{framework:job-agent}"
              }
            ],
            "formulas": [{ "formula": "query1" }],
            "display_type": "bars",
            "style": {
              "palette": "dog_classic",
              "line_type": "solid",
              "line_width": "normal"
            }
          }
        ],
        "yaxis": { "include_zero": true },
        "markers": [
          {
            "value": "y = 120000",
            "display_type": "warning dashed",
            "label": "2 min"
          }
        ]
      },
      "layout": { "x": 0, "y": 3, "width": 6, "height": 3 }
    },
    {
      "definition": {
        "type": "timeseries",
        "title": "LLM API Latency (ms)",
        "title_size": "16",
        "title_align": "left",
        "show_legend": false,
        "requests": [
          {
            "response_format": "timeseries",
            "queries": [
              {
                "name": "query1",
                "data_source": "metrics",
                "query": "avg:llm.api.latency_ms{framework:job-agent}"
              }
            ],
            "formulas": [{ "formula": "query1" }],
            "display_type": "line",
            "style": {
              "palette": "cool",
              "line_type": "solid",
              "line_width": "normal"
            }
          }
        ],
        "yaxis": { "include_zero": true }
      },
      "layout": { "x": 6, "y": 3, "width": 6, "height": 3 }
    },
    {
      "definition": {
        "type": "timeseries",
        "title": "Jobs Found vs Scored per Run",
        "title_size": "16",
        "title_align": "left",
        "show_legend": true,
        "requests": [
          {
            "response_format": "timeseries",
            "queries": [
              {
                "name": "found",
                "data_source": "metrics",
                "query": "sum:llm.job_agent.jobs_found{framework:job-agent}"
              },
              {
                "name": "scored",
                "data_source": "metrics",
                "query": "sum:llm.job_agent.jobs_scored{framework:job-agent}"
              }
            ],
            "formulas": [
              { "alias": "Jobs Found", "formula": "found" },
              { "alias": "Jobs Scored >=6", "formula": "scored" }
            ],
            "display_type": "bars",
            "style": {
              "palette": "dog_classic",
              "line_type": "solid",
              "line_width": "normal"
            }
          }
        ],
        "yaxis": { "include_zero": true }
      },
      "layout": { "x": 0, "y": 6, "width": 8, "height": 3 }
    },
    {
      "definition": {
        "type": "timeseries",
        "title": "Cover Letters Drafted per Run",
        "title_size": "16",
        "title_align": "left",
        "show_legend": false,
        "requests": [
          {
            "response_format": "timeseries",
            "queries": [
              {
                "name": "query1",
                "data_source": "metrics",
                "query": "sum:llm.job_agent.cover_letters_drafted{framework:job-agent}"
              }
            ],
            "formulas": [{ "formula": "query1" }],
            "display_type": "bars",
            "style": {
              "palette": "purple",
              "line_type": "solid",
              "line_width": "normal"
            }
          }
        ],
        "yaxis": { "include_zero": true }
      },
      "layout": { "x": 8, "y": 6, "width": 4, "height": 3 }
    }
  ]
}
